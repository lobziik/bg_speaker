#!/bin/bash
set -euo pipefail

# =============================================================================
# narrator - Twitch Narrator Bot deployment CLI
#
# Runs the all-in-one container (Caddy + app under systemd) on a single host.
# Built for a fresh OCI Ampere VM, but works anywhere podman or docker runs.
# =============================================================================

VERSION="dev"
# Both are overridable so a locally built image can be exercised with the same
# start/stop/logs commands the release uses.
VERSION="${NARRATOR_VERSION:-$VERSION}"
REPO="${NARRATOR_IMAGE:-ghcr.io/lobziik/bg_speaker}"
RELEASES_URL="https://github.com/lobziik/bg_speaker/releases/latest/download"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/narrator"
CONTAINER_NAME="narrator"
DATA_VOLUME="narrator-data"
CADDY_VOLUME="narrator-caddy"
RUNTIME=""

# =============================================================================
# Output Helpers
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log()     { echo -e "[narrator] $*"; }
success() { echo -e "${GREEN}[✓]${NC} $*"; }
warn()    { echo -e "${YELLOW}[!]${NC} $*"; }
error()   { echo -e "${RED}[✗]${NC} $*" >&2; }

# =============================================================================
# Preflight Checks
# =============================================================================

check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "Root required to bind ports 80/443"
        echo ""
        echo "Either run with sudo:"
        echo "  sudo ./narrator install"
        echo ""
        echo "Or enable unprivileged ports (one-time, requires root):"
        echo "  sudo sysctl -w net.ipv4.ip_unprivileged_port_start=80"
        echo "  echo 'net.ipv4.ip_unprivileged_port_start=80' | sudo tee /etc/sysctl.d/50-unprivileged-ports.conf"
        echo ""
        echo "Then re-run: ./narrator install"
        exit 1
    fi
}

check_runtime() {
    if command -v podman &>/dev/null; then
        RUNTIME="podman"
    elif command -v docker &>/dev/null; then
        RUNTIME="docker"
        warn "Docker detected. Podman is recommended."
    else
        echo "No container runtime found."
        echo ""
        echo "Podman is recommended (rootless, daemonless, Docker-compatible)."
        echo ""
        read -p "Install Podman now? [Y/n] " -r
        if [[ $REPLY =~ ^[Nn]$ ]]; then
            error "Container runtime required. Install podman or docker manually."
            exit 1
        fi
        install_podman
        RUNTIME="podman"
    fi
}

detect_distro_id() {
    # Read /etc/os-release in a subshell: it defines its own VERSION, which
    # would otherwise overwrite this script's and end up in the image tag.
    if [[ ! -f /etc/os-release ]]; then
        return 0
    fi
    # shellcheck source=/dev/null
    ( . /etc/os-release && echo "$ID" )
}

install_podman() {
    local distro
    distro=$(detect_distro_id)

    if [[ -z "$distro" ]]; then
        error "Cannot detect distribution. Install podman manually."
        echo "See: https://podman.io/getting-started/installation"
        exit 1
    fi

    echo "Installing Podman for $distro..."

    case "$distro" in
        ubuntu|debian)
            apt-get update
            apt-get install -y podman
            ;;
        fedora)
            dnf install -y podman
            ;;
        ol|rhel|rocky|centos|almalinux)
            dnf install -y podman
            ;;
        arch|manjaro)
            pacman -Sy --noconfirm podman
            ;;
        alpine)
            apk add podman
            ;;
        opensuse*|sles)
            zypper install -y podman
            ;;
        *)
            error "Unsupported distribution: $distro"
            echo "Install podman manually: https://podman.io/getting-started/installation"
            exit 1
            ;;
    esac

    if ! command -v podman &>/dev/null; then
        error "Podman installation failed"
        exit 1
    fi

    success "Podman installed successfully"
}

check_podman_version() {
    if [[ "$RUNTIME" != "podman" ]]; then
        return 0
    fi

    local version major
    version=$(podman --version | grep -oE '[0-9]+\.[0-9]+' | head -1)
    major=$(echo "$version" | cut -d. -f1)

    # systemd inside the container (--systemd always) needs podman 4+
    if [[ "$major" -lt 4 ]]; then
        error "Podman version 4.0+ required (found: $version)"
        echo "Upgrade podman and try again."
        exit 1
    fi
}

check_port_available() {
    local port=$1

    if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
        error "Port $port is already in use"
        echo ""
        echo "Process using port $port:"
        ss -tlnp | grep ":${port} " | head -5
        echo ""
        echo "Stop the conflicting service and try again."
        exit 1
    fi
}

check_firewall() {
    local firewall_active=false
    local firewall_name=""

    if command -v ufw &>/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
        firewall_active=true
        firewall_name="ufw"
    fi

    if command -v firewall-cmd &>/dev/null && firewall-cmd --state &>/dev/null 2>&1; then
        firewall_active=true
        firewall_name="firewalld"
    fi

    # OCI images ship restrictive iptables rules even with no firewall front-end
    if [[ "$firewall_active" == "false" ]] && iptables -L INPUT -n 2>/dev/null | grep -q REJECT; then
        firewall_active=true
        firewall_name="iptables"
    fi

    if [[ "$firewall_active" == "true" ]]; then
        warn "Host firewall ($firewall_name) is active"
        echo ""
        echo "Ports 80/tcp and 443/tcp must be open for Let's Encrypt and the dashboard."
        case "$firewall_name" in
            ufw)
                echo "  sudo ufw allow 80/tcp && sudo ufw allow 443/tcp"
                ;;
            firewalld)
                echo "  sudo firewall-cmd --permanent --add-service=http"
                echo "  sudo firewall-cmd --permanent --add-service=https"
                echo "  sudo firewall-cmd --reload"
                ;;
            iptables)
                echo "  sudo iptables -I INPUT 5 -p tcp --dport 80 -j ACCEPT"
                echo "  sudo iptables -I INPUT 6 -p tcp --dport 443 -j ACCEPT"
                echo "  sudo netfilter-persistent save   # Ubuntu"
                ;;
        esac
        echo ""
    fi

    echo "On Oracle Cloud the VCN security list (or NSG) must also allow 80/tcp and"
    echo "443/tcp from 0.0.0.0/0 - the host firewall alone is not enough."
    echo ""
    read -p "Continue? [Y/n] " -r
    if [[ $REPLY =~ ^[Nn]$ ]]; then
        exit 1
    fi
}

# =============================================================================
# Input Collection
# =============================================================================

detect_external_ip() {
    local ip=""

    ip=$(curl -sf --max-time 5 ifconfig.me 2>/dev/null) ||
    ip=$(curl -sf --max-time 5 icanhazip.com 2>/dev/null) ||
    ip=$(curl -sf --max-time 5 ipinfo.io/ip 2>/dev/null) ||
    ip=""

    echo "$ip"
}

prompt_required() {
    # prompt_required <variable-name> <prompt> [silent]
    local var_name=$1
    local prompt=$2
    local silent=${3:-false}
    local value=""

    while [[ -z "$value" ]]; do
        if [[ "$silent" == "true" ]]; then
            read -rsp "$prompt: " value
            echo ""
        else
            read -rp "$prompt: " value
        fi
        [[ -z "$value" ]] && error "This value is required"
    done

    printf -v "$var_name" '%s' "$value"
}

collect_input() {
    echo ""
    echo "=== Narrator Configuration ==="
    echo ""

    prompt_required DOMAIN "Domain pointing at this server (e.g. narrator.example.com)"
    prompt_required EMAIL "Email for Let's Encrypt notifications"

    echo ""
    echo "Dashboard login (HTTP Basic Auth, protects /settings, /queue, /logs):"
    read -rp "Admin username [admin]: " ADMIN_USERNAME
    ADMIN_USERNAME=${ADMIN_USERNAME:-admin}
    prompt_required ADMIN_PASSWORD "Admin password" true

    echo ""
    echo "LLM providers - at least one key is required."
    echo "Groq: https://console.groq.com/keys"
    echo "Gemini (also powers Gemini TTS): https://aistudio.google.com/apikey"
    read -rsp "GROQ_API_KEY (blank to skip): " GROQ_API_KEY
    echo ""
    read -rsp "GEMINI_API_KEY (blank to skip): " GEMINI_API_KEY
    echo ""

    if [[ -z "$GROQ_API_KEY" && -z "$GEMINI_API_KEY" ]]; then
        error "At least one of GROQ_API_KEY or GEMINI_API_KEY is required"
        exit 1
    fi

    echo ""
    echo "Twitch application (optional - the dashboard runs without it, but"
    echo "Channel Points redemptions need it). Create one at:"
    echo "https://dev.twitch.tv/console/apps with OAuth redirect"
    echo "  https://${DOMAIN}/auth/callback"
    read -rp "TWITCH_CLIENT_ID (blank to skip): " TWITCH_CLIENT_ID
    if [[ -n "$TWITCH_CLIENT_ID" ]]; then
        read -rsp "TWITCH_CLIENT_SECRET: " TWITCH_CLIENT_SECRET
        echo ""
        read -rp "TWITCH_CHANNEL (your channel login): " TWITCH_CHANNEL
    else
        TWITCH_CLIENT_SECRET=""
        TWITCH_CHANNEL=""
    fi

    SECRET_KEY=$(openssl rand -hex 32)
}

validate_dns() {
    local resolved external_ip

    external_ip=$(detect_external_ip)
    resolved=$(getent hosts "$DOMAIN" 2>/dev/null | awk '{print $1}' | head -1)

    if [[ -z "$resolved" ]]; then
        warn "$DOMAIN does not resolve yet"
        echo "Let's Encrypt will fail until an A record points at this server."
    elif [[ -n "$external_ip" && "$resolved" != "$external_ip" ]]; then
        warn "$DOMAIN resolves to $resolved but this host is $external_ip"
    else
        success "DNS: $DOMAIN -> $resolved"
        return 0
    fi

    echo ""
    read -p "Continue anyway? [y/N] " -r
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
}

# =============================================================================
# Configuration File
# =============================================================================

write_config() {
    mkdir -p "$CONFIG_DIR"

    cat > "$CONFIG_DIR/env" << EOF
DOMAIN=${DOMAIN}
LETSENCRYPT_EMAIL=${EMAIL}
ADMIN_USERNAME=${ADMIN_USERNAME}
ADMIN_PASSWORD=${ADMIN_PASSWORD}
SECRET_KEY=${SECRET_KEY}
GROQ_API_KEY=${GROQ_API_KEY}
GEMINI_API_KEY=${GEMINI_API_KEY}
TWITCH_CLIENT_ID=${TWITCH_CLIENT_ID}
TWITCH_CLIENT_SECRET=${TWITCH_CLIENT_SECRET}
TWITCH_CHANNEL=${TWITCH_CHANNEL}
TWITCH_REDIRECT_URI=https://${DOMAIN}/auth/callback
LOG_FORMAT=json
LOG_LEVEL=info
EOF

    chmod 600 "$CONFIG_DIR/env"
    success "Configuration saved to $CONFIG_DIR/env"
}

load_config() {
    if [[ ! -f "$CONFIG_DIR/env" ]]; then
        error "Configuration not found. Run './narrator install' first."
        exit 1
    fi

    set -a
    # shellcheck source=/dev/null
    source "$CONFIG_DIR/env"
    set +a
}

# =============================================================================
# Container Image
# =============================================================================

pull_image() {
    # A malformed tag here means something overwrote VERSION; podman's own
    # "invalid reference format" does not say what or where.
    if [[ ! "$VERSION" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        error "Refusing to pull with a malformed image tag: '$VERSION'"
        echo "Set NARRATOR_VERSION to a released version, or NARRATOR_IMAGE to a local image."
        exit 1
    fi

    echo ""
    echo "Pulling container image $REPO:$VERSION ..."

    if ! $RUNTIME pull "$REPO:$VERSION"; then
        error "Could not pull $REPO:$VERSION"
        echo ""
        echo "The tag has to exist in the registry. Either install from a release:"
        echo "  curl -fsSLO $RELEASES_URL/narrator && chmod +x narrator"
        echo "or point this script at an image you built yourself:"
        echo "  NARRATOR_IMAGE=localhost/narrator NARRATOR_VERSION=dev ./narrator install"
        exit 1
    fi

    success "Image pulled"
}

# =============================================================================
# Container Lifecycle
# =============================================================================

cmd_start() {
    load_config

    $RUNTIME rm -f "$CONTAINER_NAME" 2>/dev/null || true

    echo "Starting narrator..."

    # --health-cmd is set here rather than in the image: the OCI image format
    # buildah produces drops Dockerfile HEALTHCHECK instructions.
    $RUNTIME run -d \
        --name "$CONTAINER_NAME" \
        --hostname "$CONTAINER_NAME" \
        --systemd always \
        -p 80:80 \
        -p 443:443 \
        --env-file "$CONFIG_DIR/env" \
        -v "$DATA_VOLUME":/var/lib/narrator \
        -v "$CADDY_VOLUME":/var/lib/caddy \
        --health-cmd "curl -sf http://127.0.0.1:8000/health || exit 1" \
        --health-interval 30s \
        --health-start-period 90s \
        --restart unless-stopped \
        "$REPO:$VERSION"

    success "Container started"
}

cmd_stop() {
    echo "Stopping narrator..."
    $RUNTIME stop "$CONTAINER_NAME" 2>/dev/null || true
    $RUNTIME rm "$CONTAINER_NAME" 2>/dev/null || true
    success "Container stopped"
}

cmd_restart() {
    cmd_stop
    cmd_start
}

cmd_logs() {
    local service="${1:-}"

    case "$service" in
        "")
            $RUNTIME exec -it "$CONTAINER_NAME" journalctl -f
            ;;
        app|caddy|init)
            $RUNTIME exec -it "$CONTAINER_NAME" journalctl -u "narrator-$service" -f
            ;;
        *)
            error "Unknown service: $service"
            echo "Available: app, caddy, init"
            exit 1
            ;;
    esac
}

cmd_status() {
    echo "Container status:"
    $RUNTIME ps -a --filter "name=$CONTAINER_NAME" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
    echo ""
    echo "Service status:"
    $RUNTIME exec "$CONTAINER_NAME" systemctl status narrator-app narrator-caddy --no-pager || true
}

cmd_upgrade() {
    local script_path tmp_script
    script_path=$(realpath "$0")
    tmp_script="/tmp/narrator.new"

    echo "Downloading latest narrator CLI..."
    curl -fsSL "$RELEASES_URL/narrator" -o "$tmp_script"
    chmod +x "$tmp_script"

    echo "Updating script..."
    mv "$tmp_script" "$script_path"

    echo "Restarting with the new version..."
    exec "$script_path" restart
}

# =============================================================================
# Health Check
# =============================================================================

wait_for_health() {
    local url="https://$DOMAIN/health"
    local max_attempts=36  # 3 minutes
    local attempt=1

    echo ""
    echo "Waiting for services to start..."
    echo "(Certificate issuance may take 1-2 minutes)"
    echo ""

    while [[ $attempt -le $max_attempts ]]; do
        if curl -sf "$url" &>/dev/null; then
            echo ""
            return 0
        fi

        printf "."
        sleep 5
        ((attempt++))
    done

    echo ""
    warn "Health check timed out"
    echo ""
    echo "Troubleshooting:"
    echo "  1. Check logs:     ./narrator logs"
    echo "  2. App only:       ./narrator logs app"
    echo "  3. TLS / Caddy:    ./narrator logs caddy"
    echo "  4. Verify DNS:     getent hosts $DOMAIN"
    echo "  5. Verify ports:   ss -tlnp | grep -E ':(80|443) '"
    echo ""
    return 1
}

# =============================================================================
# Install Command
# =============================================================================

cmd_install() {
    echo ""
    echo "Narrator installer v$VERSION"
    echo ""

    check_root
    check_runtime
    check_podman_version
    check_port_available 80
    check_port_available 443
    check_firewall

    collect_input
    validate_dns
    write_config

    pull_image
    cmd_start

    if wait_for_health; then
        print_success
    else
        echo "Installation finished but the health check did not pass."
        echo "Check logs with: ./narrator logs"
    fi
}

# =============================================================================
# Help & Success Output
# =============================================================================

cmd_help() {
    cat << 'EOF'
narrator - Twitch Narrator Bot deployment CLI

Usage: ./narrator <command>

Commands:
  install       Interactive setup, pull image, start container
  start         Start container
  stop          Stop and remove container
  restart       Stop + start
  logs          Follow all logs (journalctl)
  logs app      Follow the narrator app logs
  logs caddy    Follow the Caddy / TLS logs
  logs init     Show the startup configuration log
  status        Show container and service status
  upgrade       Fetch the latest CLI, then restart
  help          Show this message

Configuration: ~/.config/narrator/env
Data volumes:  narrator-data (database + Piper voices), narrator-caddy (certificates)

Documentation: https://github.com/lobziik/bg_speaker
EOF
}

print_success() {
    cat << EOF

╔═══════════════════════════════════════════╗
║      Narrator installed successfully      ║
╚═══════════════════════════════════════════╝

Dashboard: https://$DOMAIN          (login: $ADMIN_USERNAME)
Overlay:   https://$DOMAIN/overlay  (add as OBS Browser Source)

Next steps:
  1. Open the dashboard and authorize Twitch (Connect button)
  2. Settings -> Providers: choose the LLM and TTS providers
  3. Settings -> Twitch Reward: set the Channel Points cost

Usage: ./narrator <command>

  logs      Follow logs (add: app, caddy, init)
  status    Service status
  restart   Restart the container
  upgrade   Upgrade to the latest release
  help      Show all commands

EOF
}

# =============================================================================
# Main Entry Point
# =============================================================================

main() {
    if command -v podman &>/dev/null; then
        RUNTIME="podman"
    elif command -v docker &>/dev/null; then
        RUNTIME="docker"
    else
        RUNTIME=""
    fi

    case "${1:-help}" in
        install)
            cmd_install
            ;;
        start)
            [[ -z "$RUNTIME" ]] && { error "No container runtime found"; exit 1; }
            cmd_start
            ;;
        stop)
            [[ -z "$RUNTIME" ]] && { error "No container runtime found"; exit 1; }
            cmd_stop
            ;;
        restart)
            [[ -z "$RUNTIME" ]] && { error "No container runtime found"; exit 1; }
            cmd_restart
            ;;
        logs)
            [[ -z "$RUNTIME" ]] && { error "No container runtime found"; exit 1; }
            cmd_logs "${2:-}"
            ;;
        status)
            [[ -z "$RUNTIME" ]] && { error "No container runtime found"; exit 1; }
            cmd_status
            ;;
        upgrade)
            [[ -z "$RUNTIME" ]] && { error "No container runtime found"; exit 1; }
            cmd_upgrade
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            error "Unknown command: $1"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
