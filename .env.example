# Narrator Bot Environment Variables
# Copy this file to .env and fill in your values

# === Required (for full functionality) ===
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_CHANNEL=your_channel_name
TWITCH_REDIRECT_URI=http://localhost:8000/auth/callback

# === LLM Providers (at least one required) ===
GROQ_API_KEY=gsk_...
# Google AI Studio key - powers both the Gemini LLM and Gemini TTS providers
# GEMINI_API_KEY=AIza...

# === TTS Providers ===
# Piper runs locally and needs no API key.
# Gemini TTS reuses GEMINI_API_KEY above.

# === Translation (optional) ===
# DEEPL_API_KEY=...

# === App ===
SECRET_KEY=random_secret_for_sessions_change_in_production
DATABASE_URL=sqlite:///data/narrator.db

# === Basic Auth (required for admin dashboard access) ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
